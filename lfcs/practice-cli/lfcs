#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
#  LFCS Exam Practice CLI
#  Per-question labs with automated setup, verification and cleanup,
#  a timer, progress tracking, and a scored 120-minute mock mode.
#
#  Runs as root inside the lab VMs only. Its questions create users,
#  repartition disks, rewrite firewall rules and restart services.
# ═══════════════════════════════════════════════════════════════════
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/colors.sh"
source "$SCRIPT_DIR/lib/env.sh"
if [[ -f "$SCRIPT_DIR/lib/questions.sh" ]]; then
  source "$SCRIPT_DIR/lib/questions.sh"
else
  echo "No question registry found. Generate it with: bash tools/build-registry.sh" >&2
  exit 1
fi
source "$SCRIPT_DIR/lib/progress.sh"
source "$SCRIPT_DIR/lib/menu.sh"

MOCK_DIR="$SCRIPT_DIR/../mock-exams"
TIMER_FILE="$LFCS_STATE_DIR/.timer"

qdir()  { echo "$SCRIPT_DIR/questions/$(get_question_folder "$1")"; }
upper() { echo "$1" | tr '[:lower:]' '[:upper:]'; }
pause() { echo ""; echo -e "  ${GRAY}Press Enter to continue...${RESET}"; read -r; }
select_question() {
  local n
  n=$(printf "%02d" "$1" 2>/dev/null) || n="$1"
  get_question_by_num "$n"
}

# ─── timer ─────────────────────────────────────────────────────────
start_timer()  { date +%s > "$TIMER_FILE"; print_success "${ICON_CLOCK}  Timer started"; }
elapsed_secs() { [[ -f "$TIMER_FILE" ]] || { echo 0; return; }; echo $(( $(date +%s) - $(cat "$TIMER_FILE") )); }
fmt_elapsed()  { local s; s=$(elapsed_secs); echo "$(( s / 60 ))m $(( s % 60 ))s"; }

stop_timer() {   # stop_timer target_minutes
  local target="$1" m
  m=$(( $(elapsed_secs) / 60 ))
  print_separator
  if (( m < target - 2 )); then
    echo -e "  ${GREEN}${ICON_MEDAL} Time: $(fmt_elapsed). Excellent pace.${RESET}"
  elif (( m < target )); then
    echo -e "  ${YELLOW}${ICON_CLOCK}  Time: $(fmt_elapsed). On target (${target} min).${RESET}"
  else
    echo -e "  ${RED}${ICON_CLOCK}  Time: $(fmt_elapsed). Over the ${target} min target. Drill this one again.${RESET}"
  fi
  print_separator
  rm -f "$TIMER_FILE"
}

# ─── display ───────────────────────────────────────────────────────
show_md() {
  [[ -f "$1" ]] || { print_error "Missing $1"; return 1; }
  local line
  while IFS= read -r line; do
    case "$line" in
      '#'*) echo -e "  ${BOLD}${WHITE}${line}${RESET}" ;;
      '>'*) echo -e "  ${YELLOW}${line}${RESET}" ;;
      *)    echo "  $line" ;;
    esac
  done < "$1"
}

show_question() {
  echo ""; print_separator
  echo -e "  ${BOLD}${CYAN}${ICON_BOOK} Question${RESET}"
  print_separator; echo ""
  show_md "$(qdir "$1")/question.md"
  echo ""
}

show_solution() {
  confirm_action "Show the solution?" || return 0
  echo ""; print_separator
  echo -e "  ${BOLD}${CYAN}${ICON_HINT} Solution${RESET}"
  print_separator; echo ""
  show_md "$(qdir "$1")/solution.md"
  echo ""
}

# ─── actions ───────────────────────────────────────────────────────
run_setup() {
  local q="$1" dir needs
  dir=$(qdir "$q"); needs=$(get_question_needs "$q")
  if ! has_needs "$needs"; then
    print_error "This environment does not satisfy: $needs"
    print_info "Run [E] for the full environment report."
    return 1
  fi
  clear; echo ""
  echo -e "  ${ICON_GEAR}  ${BOLD}Setting up the scenario...${RESET}"
  print_separator; echo ""
  # Setup output is shown, not swallowed: it carries the scenario facts.
  bash "$dir/setup.sh" 2>&1 | sed 's/^/  /'
  if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
    echo ""; print_success "Scenario ready."
    start_timer
    show_question "$q"
  else
    print_error "Setup failed. Fix the environment and run [S] again."
  fi
}

run_verify() {
  local q="$1"
  echo ""
  echo -e "  ${ICON_CHECK}  ${BOLD}Verifying...${RESET}"
  print_separator; echo ""
  if bash "$(qdir "$q")/verify.sh"; then
    echo ""; print_success "All checks passed."
    stop_timer "$(get_question_minutes "$q")"
    mark_complete "$(get_question_id "$q")"
  else
    echo ""; print_error "Some checks failed. Review the FAIL lines and try again."
    [[ -f "$TIMER_FILE" ]] && echo -e "  ${GRAY}${ICON_CLOCK}  Timer still running: $(fmt_elapsed)${RESET}"
  fi
}

run_cleanup() {
  local q="$1"
  confirm_action "Clean up all resources for this question?" || return 0
  echo ""
  echo -e "  ${ICON_BROOM}  ${BOLD}Cleaning up...${RESET}"
  bash "$(qdir "$q")/cleanup.sh" 2>&1 | sed 's/^/  /'
  if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
    print_success "Cleanup complete."
    rm -f "$TIMER_FILE"
  else
    print_error "Cleanup reported errors. Check the cluster manually."
  fi
}

question_loop() {
  local q="$1" action
  while true; do
    clear
    show_question_actions "$q"
    read -r action
    case "$(upper "$action")" in
      S) run_setup "$q"; pause ;;
      Q) show_question "$q"; pause ;;
      H) show_solution "$q"; pause ;;
      V) run_verify "$q"; pause ;;
      C) run_cleanup "$q"; pause ;;
      B) return ;;
      *) print_warn "Invalid option. Try S/Q/H/V/C/B"; sleep 1 ;;
    esac
  done
}

# ─── environment report ────────────────────────────────────────────
show_env() {
  print_header "${ICON_GEAR} Environment"
  local q id needs runnable=0 t sd
  echo -e "  host:         $(hostname) ($(distro))"
  if require_lab_host >/dev/null 2>&1; then
    echo -e "  lab marker:   ${GREEN}present${RESET}"
  else
    echo -e "  lab marker:   ${RED}missing, the CLI will refuse to run${RESET}"
  fi
  echo -e "  state dir:    $LFCS_STATE_DIR"
  echo -e "  deliverables: $COURSE_DIR"
  if sd=$(spare_disk 2>/dev/null); then
    echo -e "  spare disk:   $sd"
  else
    echo -e "  spare disk:   ${GRAY}none; loop-backed files will be used${RESET}"
  fi
  if ip netns add lfcs-probe >/dev/null 2>&1; then
    ip netns del lfcs-probe >/dev/null 2>&1
    echo -e "  netns peer:   available"
  else
    echo -e "  netns peer:   ${GRAY}unavailable${RESET}"
  fi
  if ssh -o BatchMode=yes -o ConnectTimeout=3 node2 true >/dev/null 2>&1; then
    echo -e "  node2:        reachable"
  else
    echo -e "  node2:        ${GRAY}unreachable; two-host questions will be skipped${RESET}"
  fi
  echo ""
  for t in lvm mdadm cryptsetup exportfs nbd-client podman virsh chronyc nft firewall-cmd ufw semanage git openssl pidstat setfacl sssd quotaon; do
    if command -v "$t" >/dev/null 2>&1; then
      printf "  tool %-14s ${GREEN}present${RESET}\n" "$t"
    else
      printf "  tool %-14s ${GRAY}missing${RESET}\n" "$t"
    fi
  done
  echo ""
  echo -e "  ${BOLD}Runnable here:${RESET}"
  for q in "${QUESTIONS[@]}"; do
    id=$(get_question_id "$q"); needs=$(get_question_needs "$q")
    if has_needs "$needs"; then
      echo -e "  ${GREEN}Q$id${RESET} $(get_question_title "$q")"
      runnable=$(( runnable + 1 ))
    else
      echo -e "  ${GRAY}Q$id needs: $needs${RESET}"
    fi
  done
  echo ""
  echo -e "  $runnable of ${#QUESTIONS[@]} questions runnable on this host."
}

# ─── mock mode ─────────────────────────────────────────────────────
mock_each() {   # mock_each N callback   -> callback id weight question
  local set_file="$MOCK_DIR/mock-$1.set" id w q
  while IFS='|' read -r id w; do
    id="${id%%[[:space:]]*}"
    [[ -z "$id" || "$id" == \#* ]] && continue
    if q=$(select_question "$id"); then
      "$2" "$id" "$w" "$q"
    else
      print_warn "unknown question id '$id' in mock-$1.set"
    fi
  done < "$set_file"
}

mock_setup_one() {
  if has_needs "$(get_question_needs "$3")"; then
    bash "$(qdir "$3")/setup.sh" >/dev/null 2>&1 || print_warn "setup failed for Q$1"
  else
    MOCK_SKIPPED="$MOCK_SKIPPED Q$1"
  fi
}

mock_list_one() {
  printf "  ${CYAN}[Q%s]${RESET} %-46s ${GRAY}%s pts  %s  %s${RESET}\n" \
    "$1" "$(get_question_title "$3")" "$2" "$(get_question_domain_short "$3")" "$(get_question_host "$3")"
}

mock_score_one() {
  MOCK_TOTAL=$(( MOCK_TOTAL + $2 ))
  if bash "$(qdir "$3")/verify.sh" >/dev/null 2>&1; then
    MOCK_EARNED=$(( MOCK_EARNED + $2 ))
    echo "$1|$2|PASS|$(get_question_domain_short "$3")" >> "$MOCK_RESULTS"
    echo -e "  ${GREEN}PASS${RESET} Q$1 ($2 pts)"
    mark_complete "$1"
  else
    echo "$1|$2|FAIL|$(get_question_domain_short "$3")" >> "$MOCK_RESULTS"
    echo -e "  ${RED}FAIL${RESET} Q$1 ($2 pts)"
  fi
}

mock_cleanup_one() { bash "$(qdir "$3")/cleanup.sh" >/dev/null 2>&1; }

mock_domain_report() {
  local d earned total
  for d in D1 D2 D3 D4 D5; do
    earned=$(awk -F'|' -v d="$d" '$4==d && $3=="PASS" {s+=$2} END {print s+0}' "$MOCK_RESULTS")
    total=$(awk -F'|' -v d="$d" '$4==d {s+=$2} END {print s+0}' "$MOCK_RESULTS")
    [[ "$total" -gt 0 ]] && printf "  %s %3d / %3d\n" "$d" "$earned" "$total"
  done
}

run_mock() {
  local n="$1" action id q pct started left
  [[ -f "$MOCK_DIR/mock-$n.set" ]] || { print_error "No such mock: mock-$n.set"; return 1; }
  MOCK_SKIPPED=""; MOCK_TOTAL=0; MOCK_EARNED=0
  MOCK_RESULTS="$LFCS_STATE_DIR/mock-$n.results"; : > "$MOCK_RESULTS"

  print_header "${ICON_TARGET} Mock exam $n"
  echo -e "  $(grep -v '^[[:space:]]*#' "$MOCK_DIR/mock-$n.set" | grep -c '|') tasks, 120 minutes, pass mark 67 percent."
  echo -e "  Setups run now. Scoring runs when you press F."
  confirm_action "Start the mock now?" || return 0

  mock_each "$n" mock_setup_one
  [[ -n "$MOCK_SKIPPED" ]] && print_warn "Skipped, environment cannot run:$MOCK_SKIPPED"
  started=$(date +%s); echo "$started" > "$TIMER_FILE"

  while true; do
    left=$(( (7200 - ($(date +%s) - started)) / 60 ))
    clear
    print_header "${ICON_TARGET} Mock exam $n: ${left} min left"
    mock_each "$n" mock_list_one
    echo ""
    echo -e "  ${CYAN}[N]${RESET} show a task   ${MAGENTA}[F]${RESET} finish and score   ${RED}[C]${RESET} cleanup all   ${GRAY}[B]${RESET} back"
    echo -ne "  ${BOLD}> ${RESET}"
    read -r action
    case "$(upper "$action")" in
      N) echo -ne "  Task number: Q"; read -r id
         if q=$(select_question "$id"); then show_question "$q"; else print_warn "No question Q$id"; fi
         pause ;;
      F) echo ""; : > "$MOCK_RESULTS"; MOCK_TOTAL=0; MOCK_EARNED=0
         mock_each "$n" mock_score_one
         pct=0; [[ $MOCK_TOTAL -gt 0 ]] && pct=$(( MOCK_EARNED * 100 / MOCK_TOTAL ))
         print_separator
         echo -e "  ${BOLD}Score: $MOCK_EARNED / $MOCK_TOTAL points = ${pct}% (pass mark 67%). Time: $(fmt_elapsed)${RESET}"
         mock_domain_report
         print_separator
         echo "$(date '+%F %T') mock-$n $MOCK_EARNED/$MOCK_TOTAL ${pct}% $(fmt_elapsed)" >> "$LFCS_STATE_DIR/mock-results.log"
         rm -f "$TIMER_FILE"
         pause ;;
      C) if confirm_action "Clean up every task in this mock?"; then
           mock_each "$n" mock_cleanup_one
           print_success "Mock cleaned up."
         fi
         pause ;;
      B) return 0 ;;
      *) print_warn "Invalid option."; sleep 1 ;;
    esac
  done
}

# ─── main ──────────────────────────────────────────────────────────
main() {
  local choice qnum q
  while true; do
    clear
    show_main_menu
    read -r choice
    case "$(upper "$choice")" in
      1) show_question_list; pause ;;
      2) show_question_list; show_question_selector; read -r qnum
         [[ "$qnum" =~ ^[Bb]$ ]] && continue
         if q=$(select_question "$qnum"); then
           question_loop "$q"
         else
           print_error "Question Q${qnum} not found."; sleep 1
         fi ;;
      3) if qnum=$(get_random_incomplete); then
           q=$(select_question "$qnum"); question_loop "$q"
         else
           print_success "Every question is complete."; sleep 1
         fi ;;
      4) show_progress; pause ;;
      5) echo -ne "  Mock number (1-3): "; read -r qnum; run_mock "$qnum" ;;
      E) show_env; pause ;;
      Q) echo ""
         echo -e "  ${ICON_ROCKET} ${BOLD}Good luck on your LFCS. Own the box.${RESET}"
         echo ""
         exit 0 ;;
      *) print_warn "Invalid option."; sleep 1 ;;
    esac
  done
}

# --list and --help are read-only, so they neither escalate nor demand the lab
# marker. Everything else touches real system state and does both.
case "${1:-}" in
  --list) show_question_list; exit 0 ;;
  -h|--help)
    echo "usage: lfcs [--list | --env | --mock N]"
    echo "  --list   every question with its needs tags (no root required)"
    echo "  --env    what this host can run (root)"
    echo "  --mock N run mock N, scored, 120 minutes (root)"
    exit 0 ;;
esac

require_root "$@"
require_lab_host || exit 1

case "${1:-}" in
  --env)  show_env; exit 0 ;;
  --mock) run_mock "${2:-1}"; exit 0 ;;
esac

main
